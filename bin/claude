#!/usr/bin/env bash
# fedora-dev — the `claude` entry wrapper. Baked at /usr/local/bin/claude.
#
# Runs Claude Code INSIDE claudebox. Holds a SHARED `flock` on session.lock for the
# session's lifetime so that:
#   * the daily in-box rebuild (claudebox-daily.sh) defers while you work
#   * the host's monthly fedora-dev refresh (lock-probed via `podman exec`) defers
#     while you work
#
# On exit:
#   (a) If a Claude-triggered rebuild is running, follow it instead of leaving you
#       at the prompt thinking you're done.
#   (b) Else if a daily refresh was deferred AND no other session is active now,
#       fire the rebuild and follow it.
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
state="$HOME/.local/state/claudebox"; mkdir -p "$state"

# A claudebox rebuild is in progress iff box-rebuild.sh is holding its
# self-serialization flock on box-rebuild.lock (it grabs it via `exec 9<>…;
# flock -n 9` and holds it for the rebuild's duration — it runs claudebox-assemble.sh
# as a CHILD with fd 9 CLOSED, so the long-lived box can't inherit the lock and it
# releases cleanly when box-rebuild.sh exits). Probe it non-destructively in a
# subshell with its own fd 9 (released on exit).
#
# This REPLACES `pgrep -f fedora-dev/box-rebuild.sh`: that pattern also matched
# the entrypoint's PERMANENT inotify rebuild-watcher, whose command line embeds
# that exact path — so the check was ALWAYS true and wedged `claude` into an
# endless watch-only tail of a rebuild.log that never appears.
rebuild_in_progress() {
    ! ( exec 9<>"$state/box-rebuild.lock"; flock -n 9 ) 2>/dev/null
}

# If a rebuild is already in flight, don't enter a half-built box — follow it.
if rebuild_in_progress; then
    exec /usr/local/bin/claudebox-rebuild --watch-only
fi

# If first-boot assemble hasn't happened yet (eager assemble still running, or it
# crashed), wait for it or report. Also recover a box left broken by a FAILED
# assemble (#115): .assemble-failed present overrides a stale .assembled so entering
# the box re-assembles instead of dropping into a half-assembled shell.
if [ ! -e "$state/.assembled" ] || [ -e "$state/.assemble-failed" ]; then
    if pgrep -f "fedora-dev/claudebox-assemble.sh" >/dev/null 2>&1; then
        echo ">> first-boot claudebox assemble is still running — tailing it…"
        echo "   ($(date)) Once complete this command will continue."
        tail -F "$state/first-assemble.log" 2>/dev/null &
        tail_pid=$!
        while pgrep -f "fedora-dev/claudebox-assemble.sh" >/dev/null 2>&1; do sleep 2; done
        kill "$tail_pid" 2>/dev/null
    else
        echo ">> first-boot assemble has not run yet — starting it inline."
        bash /home/core/.local/share/fedora-dev/claudebox-assemble.sh \
            2>&1 | tee "$state/first-assemble.log"
    fi
fi

# Hold the SHARED session lock for the session's lifetime.
# BOX STARTUP DEFAULTS (Arthur, 2026-07-11 — a fleet build requirement; the box must come up ready to
# work at full capability with NO per-session toggling). Three launch flags, all session-scoped so they
# survive rebuilds without depending on accumulated home state, and all overridable mid-session:
#   --model default        the RECOMMENDED model, NOT a version pin. The `default` alias resolves to the
#                          provider's recommended model and AUTO-FOLLOWS new releases (currently Opus 4.8,
#                          Sonnet 5 on lower tiers) — every recommended tier is xhigh/ultracode-capable, so
#                          this both un-pins the model AND avoids the 2.1.195 regression where NO --model
#                          let the client default to a Sonnet tier with no ultracode. (Was `--model opus`,
#                          a version pin Arthur explicitly does not want.) Overridable via /model.
#   --permission-mode auto AUTO mode, not manual — the box starts autonomous. A launch flag (not home
#                          state), so a FRESH box reliably starts in auto (a bare box came up "manual").
#                          RECONCILIATION with the 2026-07-11 unshackle: that change set managed-settings
#                          `defaultMode: default` as the NO-FLAG floor (so a non-wrapper invocation does
#                          not silently inherit auto). This launch flag is the DELIBERATE per-box override
#                          back to auto for the operator's own session — an explicit choice, not a silent
#                          regression — and it does NOT re-add the removed gate-push hook/prompts.
#                          Overridable via shift+tab.
#   --effort ultracode     the canonical current ultracode flag (xhigh effort + dynamic workflows).
#                          Replaces the old `--settings '{"ultracode":true}'` injection; ultracode is
#                          session-only by design (it cannot be persisted in a settings file).
#
# Retry the transient post-rebuild OCI/PTY race: right after a box rebuild the freshly (re)started
# container's /dev/pts can need a moment before an interactive `podman exec` can allocate a
# pseudo-terminal, so the FIRST `distrobox enter` can fail with
#     Error: OCI runtime error: crun: ptsname: Inappropriate ioctl for device
# distrobox-enter ends in `exec "$@"` (it execs into `podman exec`), so podman's exit code reaches us
# verbatim through flock. 125/126 are podman/OCI exec-SETUP failures: a session that actually started
# returns its OWN code (claude is a Node app that exits 0/1/130, not these), so they uniquely mark
# "couldn't enter yet" and are the only codes safe to retry. Bounded to 6 retries, short escalating
# backoff capped at 4s (~18s total — comfortably past the observed ~15s warmup window). Every other
# outcome breaks out at once and is surfaced unchanged: success, Ctrl-C=130, a genuine nonzero — and
# the start-phase path (a box that is NOT already running enters via distrobox's start block, which
# returns 1, not 125/126; that path boots PID 1 with no interactive pty, so /dev/pts has settled
# before the exec and the ptsname race does not arise there — it is intentionally not retried).
attempt=0
while :; do
    flock -s "$state/session.lock" \
        distrobox enter claudebox -- bash -lc 'exec /usr/bin/claude --model default --permission-mode auto --effort ultracode "$@"' bash "$@"
    rc=$?
    { [ "$rc" -eq 125 ] || [ "$rc" -eq 126 ]; } && [ "$attempt" -lt 6 ] || break
    attempt=$((attempt + 1))
    printf >&2 '>> claudebox is still warming up after the rebuild — retrying entry (%d/6)…\n' "$attempt"
    sleep "$(( attempt < 4 ? attempt : 4 ))"
done

# Post-session: follow a Claude-triggered rebuild, or fire a deferred daily one.
if rebuild_in_progress; then
    exec /usr/local/bin/claudebox-rebuild --watch-only
fi

# Atomic check-and-claim of rebuild.pending under EXCLUSIVE session lock:
# protects against two concurrent `claude` exits both seeing the marker and
# both firing a rebuild. Subshell opens fd 9 to session.lock; flock -n -x
# claims; second concurrent exit's flock fails non-blockingly and exits 1.
# Release the lock (exec 9>&-) BEFORE launching claudebox-rebuild so the lock
# doesn't get inherited and held by the rebuild process (which would confuse
# the next daily probe).
(
    flock -n -x 9 || exit 1
    [ -e "$state/rebuild.pending" ] || exit 0
    rm -f "$state/rebuild.pending"
    exec 9>&-
    echo ">> a daily claudebox refresh came due while you were working — rebuilding now…"
    exec /usr/local/bin/claudebox-rebuild
) 9>"$state/session.lock"

exit "$rc"
