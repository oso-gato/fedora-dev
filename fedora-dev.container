# fedora-dev.container — systemd Quadlet for fedora-dev.
#
# DROP-IN PATH (rootless / user): ~/.config/containers/systemd/
# DROP-IN PATH (rootful / system): /etc/containers/systemd/
#
# systemd-generator reads this on `systemctl --user daemon-reload` and emits
# `fedora-dev.service`. Manage via:
#   systemctl --user start fedora-dev.service
#   systemctl --user status fedora-dev.service
#   journalctl --user -u fedora-dev.service
#
# v1.1.9: NO RUNTIME SECRETS. sshd is key-only — keys synced from
# github.com/oso-gato.keys at every container start, cached on home volume.
# No EnvironmentFile=, no CORE_PASSWORD, no env-file scaffold to populate.
# Public ssh on host:4444 (container:22, key auth) + mosh public on UDP
# 61001-62000. Tailscale SSH (tailnet, keyless) remains primary.
#
# Optional: TS_AUTHKEY for unattended tailnet join can be added via a
# `Secret=` directive (podman secret create fedora-dev-ts-authkey -); the
# entrypoint honors $TS_AUTHKEY if set, falls back to interactive join.

[Unit]
Description=fedora-dev — headless Fedora workshop for building container images
Documentation=https://github.com/oso-gato/fedora-dev
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/oso-gato/fedora-dev:latest
ContainerName=fedora-dev
# Stable in-container hostname. Without this, podman falls back to the
# (truncated) container ID, which regenerates on every recreate/refresh —
# yielding a new random hostname each cycle. Mirrors run.sh's --hostname.
HostName=fedora-dev
# Pull policy: MISSING, not newer. The bootstrap workload-refresh harness is the
# SOLE puller — it runs an explicit `podman pull` + digest-compare BEFORE it
# restarts this unit, so a plain restart uses the LOCAL image and never re-contacts
# the registry on its own. This is load-bearing for the harness's auto-rollback:
# on a health failure it retags :latest to the prior-good digest LOCALLY and
# restarts — Pull=newer would re-pull the (bad) registry :latest on that restart
# and silently defeat the rollback. Do NOT change to Pull=newer/always.
Pull=missing
# Label the container for `podman auto-update` discoverability (manual
# `podman auto-update --dry-run` checks). The actual update cadence is driven
# by the bootstrap workload-refresh harness, not the global auto-update timer.
AutoUpdate=registry
# Unit considered "active" when the healthcheck transitions to healthy.
# Combined with rollback logic in container-refresh.sh, a failed-to-healthy
# new image triggers retag-to-prior-digest and restart.
Notify=healthy

# Runtime args — mirror of run.sh.
# NET_ADMIN: tailscaled programs the nft firewall + mosh. SYS_ADMIN: the nested claudebox
# (`distrobox enter`) calls sethostname() to name the inner box; podman's default seccomp
# gates sethostname/setdomainname behind CAP_SYS_ADMIN and seccomp is NOT namespace-aware,
# so without it the first-boot claudebox assemble dies with `crun: sethostname: Operation
# not permitted`. Deliberate — do NOT remove: it breaks the nested dev box. Bounded by the
# rootless userns (uid 1000, subuid 10000-64999), NOT host root, and keeps the FULL default
# seccomp profile active (vs forking it). Composes with label=disable below.
AddCapability=NET_ADMIN SYS_ADMIN
AddDevice=/dev/net/tun
AddDevice=/dev/fuse
# SELinux label separation is INTENTIONALLY OFF. Nested rootless podman +
# fuse-overlayfs on the home volume + the passed /dev/fuse and /dev/net/tun
# cannot run under container_t confinement (SELinux denies the overlay mount +
# device access). Deliberate, reviewed trade-off — NOT a bug to "harden" away:
# removing it breaks nested builds. Blast radius is bounded by rootless +
# user-namespace (uid 1000, subuid 10000-64999), NOT by SELinux; the HOST stays
# enforcing. Do NOT copy this to other workloads without the same analysis.
# See policy/CLAUDE.md OPERATING FACTS.
SecurityLabelDisable=true

# Persistent volumes (named) — survive container recreation and image refresh.
Volume=fedora-dev-home:/home/core
Volume=fedora-dev-state:/var/lib/tailscale

# Optional STANDING GitHub credential — so the in-box dev loop never stops for auth.
# Provide the App private key as a podman secret + the App identity as env, then
# uncomment the two lines (the key mounts into tmpfs at /run/secrets/gh_app_key,
# never persisted; the entrypoint mints a <=1h installation token on demand):
#   podman secret create gh_app_key ./app-private-key.pem
# Secret=gh_app_key,type=mount,target=gh_app_key
# Environment=GH_APP_ID=000000 GH_APP_INSTALLATION_ID=00000000

# Optional FITNESS-REVIEW App credential — the fleet-wide INDEPENDENT reviewer identity
# (oso-gato-fitness-claudebox; DISTINCT from the dev App — auto-merge.sh rejects self-authored
# verdicts). Key as a podman secret; the entrypoint mints a <=1h token and ferries ONLY
# the token to the home volume (the key never enters the claudebox). The IDs below are
# the fleet constants (public, not secrets); uncomment the two lines to enable:
#   podman secret create gh_app_key_fitness ./fitness-app-private-key.pem
# Secret=gh_app_key_fitness,type=mount,target=gh_app_key_fitness
# Environment=GH_APP_FITNESS_ID=4241099 GH_APP_FITNESS_INSTALLATION_ID=145067591

# Optional DEV-SIDE PR POLLER (Step 5 / #93) as a headless in-box service. OPT-IN + DISARMED:
# reviews + routes open PRs but NEVER merges until armed. Uncomment to enable; add ` POLLER_ARMED=1`
# only as the #96 Tier-A arming flip (autonomous Tier-B/C merges). See bin/poller-service.sh.
# Environment=POLLER_ENABLED=1

# R17 RESUME-BY-ID default ON (self-sustaining multi-tenancy): bin/rebuild-request.sh emits the v2
# 4-field manifest so every session — incl. N tenants sharing a cwd — restores BY SESSION-ID, not by
# cwd (which collapses shared-cwd tenants). Requires the host executor on fedora-bootstrap#143 (merged
# 2026-07-15); against a pre-#143 executor a v2 manifest is FAIL-SAFE REFUSED (rc=2 before the kill,
# no session stranded), so this is safe to default on. Set DEVBOX_MANIFEST_V2=0 to force v1.
Environment=DEVBOX_MANIFEST_V2=1

# Optional TS_AUTHKEY for an UNATTENDED tailnet join — a podman secret injected as an ENV
# VAR (type=env; the entrypoint honors $TS_AUTHKEY, else falls back to web-login).
# fedora-bootstrap's setup-user creates the secret from the spin-up answer and uncomments:
#   podman secret create fedora-dev-ts-authkey -
# Secret=fedora-dev-ts-authkey,type=env,target=TS_AUTHKEY

# Public ports:
#   4444/tcp -> container :22 (sshd, key-only; keys synced from github.com/oso-gato.keys)
#   61001-62000/udp -> mosh (bootstraps over the same key-auth ssh)
# Tailscale SSH on the tailnet IP is separate (handled by tailscaled inside
# the container, not via these published ports) and remains keyless.
PublishPort=4444:22
PublishPort=61001-62000:61001-62000/udp

# Health = liveness of the core services PLUS readiness of the nested rootless
# podman API socket (the CONTAINER_HOST bridge). The socket check catches a
# broken-but-running image (e.g. the socket failing to bind) so Notify=healthy
# and the harness's auto-rollback actually fire. Still NOT gated on assembly
# COMPLETION (background + slow on first boot) — that would cause false-unhealthy
# rollbacks — but IS gated on assembly not having FAILED: claudebox-assemble.sh
# writes .assemble-failed on a non-zero exit (cleared on success), so a
# half-assembled box (#11) reads UNHEALTHY while a normal in-progress first-boot
# assemble (marker absent) stays healthy. Must match run.sh's --health-cmd.
# pgrep needs procps-ng (base image).
HealthCmd=pgrep -x sshd && pgrep -x tailscaled && test -S /run/user/1000/podman/podman.sock && ! test -e /home/core/.local/state/claudebox/.assemble-failed
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
